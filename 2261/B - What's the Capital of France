void solve(){
   int n;
   cin>>n;
   vector<long long > a(n);
   for(int i=0;i<n;i++)cin>>a[i];
sort(a.begin(),a.end(),greater<long long > ());
long long  mx=a[0],ans=mx;
 
for(int q=30;q>=0;q--)
{
    if(!((mx>>q)&1))continue;
    long long y=((mx>>(q+1))<<(q+1))|((1LL<<q)-1);
    if(a.back()<=y)
    {
        ans=mx|((1LL<<q)-1);
        break;
    }
}
cout<<ans<<endl;
 
}
 
int main(){
    int t;
    cin>>t;
    while(t--)solve();
    return 0;
